    {
      "endpoint": "*",
      "category": "auth",
      "documented": "Every request must carry the API key appended as a query parameter: GET /v1/listings?api_key=...",
      "actual": "API key query parameter is rejected with 401. Server strictly requires key sent via X-API-Key request header.",
      "how_found": "Sent GET request with api_key query param, received 401 error stating header is required.",
      "impact": "High - all requests using documented query parameter fail.",
      "evidence": []
    },
    {
      "endpoint": "/auth/login",
      "category": "auth",
      "documented": "Returns token field valid for 24 hours (86400s) with no refresh flow.",
      "actual": "Returns access_token expiring in 15 minutes (900s), refresh_token, and refresh endpoint at /auth/refresh.",
      "how_found": "Inspected POST /auth/login response payload keys and expires_in value.",
      "impact": "High - user session terminates after 15 minutes if refresh flow is unhandled.",
      "evidence": []
    },
    {
      "endpoint": "/v1/listings",
      "category": "auth",
      "documented": "Implies collection endpoints can be browsed without end user authentication.",
      "actual": "Server returns 401 missing bearer token - log in at POST /auth/login first on all /v1 endpoints.",
      "how_found": "Called /v1/listings with X-API-Key but no Authorization header; received 401 requiring bearer token.",
      "impact": "High - unauthenticated requests cannot read listings.",
      "evidence": []
    },
    {
      "endpoint": "/v1/listings",
      "category": "pagination",
      "documented": "Pagination takes page (1-indexed) and limit (max 200). Response format: {total, page, page_size, results}.",
      "actual": "Pagination uses offset (0-indexed) and limit capped at 50 max. Response format: {limit, offset, count, total, has_more, results}.",
      "how_found": "Passed limit=200 and page=1; server returned 50 items and required offset parameter.",
      "impact": "Medium - limit=200 requests silently cap at 50 items.",
      "evidence": []
    },
    {
